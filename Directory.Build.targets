<Project>
  <Target
    Name="BlockUnapprovedProductPublish"
    BeforeTargets="PrepareForPublish"
    Condition="'$(MSBuildProjectName)' == 'ModConductor.Engine' and '$(ModConductorLocalPublishVerificationOnly)' != 'true'"
  >
    <Error Text="Product publish is blocked pending licence compliance, source delivery, and explicit publication approval. For local verification or private Nix package construction only, pass -p:ModConductorLocalPublishVerificationOnly=true; do not publish or redistribute the output." />
  </Target>
</Project>
