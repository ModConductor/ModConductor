<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><PublishAot>true</PublishAot><TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors><ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Report.fs"/><Compile Include="Fixtures.fs"/><Compile Include="NativeChild.fs"/><Compile Include="StorageWorker.fs"/><Compile Include="StorageFixtures.fs"/><Compile Include="WorkspaceWorker.fs"/><Compile Include="WorkspaceFixtures.fs"/><Compile Include="LibraryWorker.fs"/><Compile Include="InventoryObservations.fs"/><Compile Include="LibraryFixtures.fs"/><Compile Include="LibraryRecoveryFixtures.fs"/><Compile Include="LibraryIdentityFixtures.fs"/><Compile Include="SelectionFixtures.fs"/><Compile Include="OrganizationFixtures.fs"/><Compile Include="OrganizationMigration.fs"/><Compile Include="PlanningFixtures.fs"/><Compile Include="GameContextFixtures.fs"/><Compile Include="SteamDiscoveryFixtures.fs"/><Compile Include="ProtonFixtures.fs"/><Compile Include="FileVisibilityFixtures.fs"/><Compile Include="ConcurrentRootFixtures.fs"/><Compile Include="FilePlanningFixtures.fs"/><Compile Include="DeploymentFixtureData.fs"/><Compile Include="DeploymentBoundaryFixtures.fs"/><Compile Include="DeploymentFixtures.fs"/><Compile Include="GenerationCleanup.fs"/><Compile Include="GenerationFixtures.fs"/><Compile Include="GenerationCorrectionFixtures.fs"/><Compile Include="DeploymentLiveFixture.fs"/><Compile Include="DeploymentProcessFixtures.fs"/><Compile Include="DeploymentBackendFixtures.fs"/><Compile Include="GeneratedOutputRecoveryFixtures.fs"/><Compile Include="GeneratedOutputFixtures.fs"/><Compile Include="ExecutableChild.fs"/><Compile Include="ExecutableFixtures.fs"/><Compile Include="GameLaunchChild.fs"/><Compile Include="GameLaunchProcessFixture.fs"/><Compile Include="GameLaunchCancellationFixture.fs"/>
    <Compile Include="GameLaunchFixtures.fs"/><Compile Include="ProfileDataFixtures.fs"/><Compile Include="ArtifactFixtures.fs"/><Compile Include="DownloadServer.fs"/><Compile Include="DownloadFixtures.fs"/><Compile Include="ArchiveInspectionFixtures.fs"/><Compile Include="InstallationFixtures.fs" />
    <Compile Include="Program.fs"/>
    <ProjectReference Include="../../src/ModConductor.DeploymentRecovery/ModConductor.DeploymentRecovery.fsproj"/>
    <ProjectReference Include="../../src/ModConductor.Platform/ModConductor.Platform.fsproj"/>
    <ProjectReference Include="../../src/ModConductor.DeploymentPlanning/ModConductor.DeploymentPlanning.fsproj"/>
    <ProjectReference Include="../../src/ModConductor.Persistence/ModConductor.Persistence.fsproj"/>
    <ProjectReference Include="../../src/ModConductor.SteamDiscovery/ModConductor.SteamDiscovery.fsproj"/>
    <PackageReference Include="FSharp.Core"/>
    <Content Include="../fixtures/archives/*.rar" Link="fixtures/archives/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="../fixtures/state-v5.db" Link="fixtures/state-v5.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="../fixtures/state-v4.db" Link="fixtures/state-v4.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="../fixtures/state-v1.db" Link="fixtures/state-v1.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
