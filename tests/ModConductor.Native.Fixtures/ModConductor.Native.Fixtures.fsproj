    <Compile Include="BethesdaSamples.fs" />
    <Compile Include="ProfileTransportFixtures.fs" />
    <Compile Include="GameLaunchFixtures.fs"/><Compile Include="ProfileDataFixtures.fs"/><Compile Include="TextEditFixtures.fs"/><Compile Include="ArtifactFixtures.fs"/><Compile Include="DownloadFixtures.fs"/><Compile Include="BethesdaArchiveFixtures.fs"/><Compile Include="ArchiveInspectionFixtures.fs"/><Compile Include="InstallationFixtures.fs" />
    <Compile Include="MaintenanceDeployments.fs" />
