<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bootstrap.fs" />
    <Compile Include="SessionAuthentication.fs" />
    <Compile Include="Probe.fs" />
    <Compile Include="ProbeService.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../ModConductor.Protocol/ModConductor.Protocol.csproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
  </ItemGroup>
</Project>
