<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SessionKey.fs" />
    <Compile Include="Bootstrap.fs" />
    <Compile Include="SessionAuthentication.fs" />
    <Compile Include="Probe.fs" />
    <Compile Include="OperationService.fs" />
    <Compile Include="ProfileActionStream.fs" />
    <Compile Include="WorkspaceService.fs" />
    <Compile Include="ModLibraryWire.fs" />
    <Compile Include="ModLibraryService.fs" />
    <Compile Include="ProfileModService.fs" />
    <Compile Include="OrganizationWire.fs" />
    <Compile Include="ModOrganizationService.fs" />
    <Compile Include="ProtonWire.fs" />
    <Compile Include="GameContextService.fs" />
    <Compile Include="SteamDiscoveryService.fs" />
    <Compile Include="ProtonContextService.fs" />
    <Compile Include="FilePlanWire.fs" />
    <Compile Include="FilePlanService.fs" />
    <Compile Include="OutputWire.fs" />
    <Compile Include="OutputService.fs" />
    <Compile Include="DeploymentWire.fs" />
    <Compile Include="DeploymentService.fs" />
    <Compile Include="ExecutableWire.fs" />
    <Compile Include="ExecutableService.fs" />
    <Compile Include="GameLaunchService.fs" />
    <Compile Include="ProfileDataWire.fs" />
    <Compile Include="ProfileDataService.fs" />
    <Compile Include="ArtifactService.fs" />
    <Compile Include="DownloadService.fs" />
    <Compile Include="ArchiveInspectionService.fs" />
    <Compile Include="InstallationWire.fs" />
    <Compile Include="InstallationService.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../ModConductor.SteamDiscovery/ModConductor.SteamDiscovery.fsproj" />
    <ProjectReference Include="../ModConductor.Persistence/ModConductor.Persistence.fsproj" />
    <ProjectReference Include="../ModConductor.Workspaces/ModConductor.Workspaces.fsproj" />
    <ProjectReference Include="../ModConductor.Operations/ModConductor.Operations.fsproj" />
    <ProjectReference Include="../ModConductor.Protocol/ModConductor.Protocol.csproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
  </ItemGroup>
</Project>
